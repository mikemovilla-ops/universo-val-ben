# Copia este archivo como .env y rellena tus propios valores.

# Base de datos Postgres (Neon)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales de Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"

# Emails con permisos de administrador (gestionar la familia: añadir
# personas, relaciones, fotos de perfil...), separados por comas. El admin
# puede entrar aunque todavía no esté dado de alta como persona.
ADMIN_EMAILS="tuemail@gmail.com"

# Fotos (álbum, recetas, perfiles) en Vercel Blob. En Vercel se rellena solo
# al crear el Blob store (Storage → Blob → Connect). En local, cópialo de
# Vercel → Storage → tu store → ".env.local".
BLOB_READ_WRITE_TOKEN=""

# Avisos por email (Gmail SMTP): receta pedida → padres y admin; receta
# terminada → hijos y admin. Opcional: si se dejan vacíos, la app funciona
# igual pero no manda avisos. En local no se manda nunca ningún email (solo
# se apunta en la consola); en las previews de Vercel solo les llegan a los
# admins, para no molestar a la familia mientras se prueba.
# 1. Activa la verificación en dos pasos en tu cuenta de Gmail.
# 2. Ve a https://myaccount.google.com/apppasswords, genera una para "Correo"
#    y pégala aquí (16 caracteres, sin espacios).
GMAIL_USER="tuemail@gmail.com"
GMAIL_APP_PASSWORD="contraseña de aplicación de 16 caracteres"
